PLANNR_IMAGE=ghcr.io/paradoxon-tools/plannr-server:enable-banking
PLANNR_BIND_ADDRESS=127.0.0.1
PLANNR_SERVER_HOST_PORT=8080
PLANNR_DB_NAME=plannr
PLANNR_DB_USERNAME=plannr
PLANNR_DB_PASSWORD=replace-with-a-long-password
ENABLE_BANKING_APPLICATION_ID=replace-with-your-application-id
ENABLE_BANKING_PRIVATE_KEY_FILE=./private-key.pem
ENABLE_BANKING_REDIRECT_URL=https://your-server.example/banking/callback
