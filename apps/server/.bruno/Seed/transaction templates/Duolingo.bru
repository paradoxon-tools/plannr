meta {
  name: Duolingo
  type: http
}

post {
  url: {{baseUrl}}/transactions/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sourcePocketId": "{{seedContractPocketId}}",
    "destinationPocketId": null,
    "partnerId": "{{seedPartnerId}}",
    "title": "Duolingo",
    "description": null,
    "amount": 12299,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2025-11-15",
    "finalOccurrenceDate": null,
    "recurrenceType": "YEARLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [15],
    "monthsOfYear": [11],
    "maxRecurrenceCount": null
  }
}

vars:pre-request {
  contractAccountName: Insurance & Contracts
  contractName: Duolingo
  partnerName: Duolingo
  transactionType: EXPENSE
  reserveSourceAccountName: Income Bucket
  reserveSourcePocketName: Default
}