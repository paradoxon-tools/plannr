meta {
  name: Internet
  type: http
}

post {
  url: {{baseUrl}}/transactions/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sourcePocketId": "{{seedContractPocketId}}",
    "destinationPocketId": null,
    "partnerId": "{{seedPartnerId}}",
    "title": "Internet",
    "description": null,
    "amount": 2498,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2024-11-30",
    "finalOccurrenceDate": "2025-01-30",
    "recurrenceType": "MONTHLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [30],
    "monthsOfYear": null,
    "maxRecurrenceCount": null
  }
}

vars:pre-request {
  contractAccountName: Rent & Appliances
  contractName: Internet
  partnerName: Vodafone
  transactionType: EXPENSE
  reserveSourceAccountName: Income Bucket
  reserveSourcePocketName: Default
}