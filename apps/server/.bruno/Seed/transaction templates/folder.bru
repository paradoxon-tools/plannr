meta {
  name: transaction templates
  seq: 3
}

script:pre-request {
  const baseUrl = bru.getEnvVar("baseUrl") || bru.getVar("baseUrl");
  
    const contractName = bru.getRequestVar("contractName");
    const partnerName = bru.getRequestVar("partnerName");
  
    const incomeBucket = "Income Bucket";
    const insuranceAndContracts = "Insurance & Contracts";
    const rentAndAppliances = "Rent & Appliances";
  
    function send(options) {
      return new Promise((resolve, reject) => {
        bru.sendRequest(options, (error, response) => {
          if (error) {
            reject(error);
            return;
          }
  
          resolve(response);
        });
      });
    }
  
    function responseData(response, entityType) {
      const body = response.data ?? response.body;
      const data = typeof body === "string" ? JSON.parse(body) : body;
  
      if (!Array.isArray(data)) {
        throw new Error(
          `Expected ${entityType} response to be an array`
        );
      }
  
      return data;
    }
  
    function findByName(entities, name, entityType) {
      const entity = entities.find((item) => item.name === name);
  
      if (!entity) {
        throw new Error(`No ${entityType} found with name '${name}'`);
      }
  
      return entity;
    }
  
    function findDefaultPocket(account, pockets) {
      const pocket = pockets.find(
        (item) => item.accountId === account.id && item.isDefault === true
      );
  
      if (!pocket) {
        throw new Error(
          `No default pocket found for account '${account.name}'`
        );
      }
  
      return pocket;
    }
  
    if (!baseUrl) {
      throw new Error("Missing 'baseUrl'");
    }
  
    if (!contractName) {
      throw new Error("Missing request variable 'contractName'");
    }
  
    if (!partnerName) {
      throw new Error("Missing request variable 'partnerName'");
    }
  
    const requestHeaders = {
      Accept: "application/json"
    };
  
    const [
      accountsResponse,
      pocketsResponse,
      contractsResponse,
      partnersResponse
    ] = await Promise.all([
      send({
        method: "GET",
        url: `${baseUrl}/accounts?archived=false`,
        headers: requestHeaders
      }),
      send({
        method: "GET",
        url: `${baseUrl}/pockets?archived=false`,
        headers: requestHeaders
      }),
      send({
        method: "GET",
        url: `${baseUrl}/contracts?archived=false`,
        headers: requestHeaders
      }),
      send({
        method: "GET",
        url: `${baseUrl}/partners?archived=false`,
        headers: requestHeaders
      })
    ]);
  
    const accounts = responseData(accountsResponse, "accounts");
    const pockets = responseData(pocketsResponse, "pockets");
    const contracts = responseData(contractsResponse, "contracts");
    const partners = responseData(partnersResponse, "partners");
  
    const contract = contracts.find((item) => item.name === contractName);
  
    if (!contract) {
      throw new Error(`No contract found with name '${contractName}'`);
    }
  
    const contractPocket = pockets.find(
      (pocket) => pocket.contractId === contract.id
    );
  
    if (!contractPocket) {
      throw new Error(
        `No pocket found for contract '${contractName}' with ID ${contract.id}`
      );
    }
  
    const partner = findByName(partners, partnerName, "partner");
  
    const incomeBucketAccount = findByName(
      accounts,
      incomeBucket,
      "account"
    );
  
    const insuranceAndContractsAccount = findByName(
      accounts,
      insuranceAndContracts,
      "account"
    );
  
    const rentAndAppliancesAccount = findByName(
      accounts,
      rentAndAppliances,
      "account"
    );
  
    const incomeBucketPocket = findDefaultPocket(
      incomeBucketAccount,
      pockets
    );
  
    const insuranceAndContractsPocket = findDefaultPocket(
      insuranceAndContractsAccount,
      pockets
    );
  
    const rentAndAppliancesPocket = findDefaultPocket(
      rentAndAppliancesAccount,
      pockets
    );
  
    bru.setVar("contractPocketId", contractPocket.id);
    bru.setVar("contractId", contract.id);
    bru.setVar("partnerId", partner.id);
    bru.setVar("incomeBucketPocketId", incomeBucketPocket.id);
    bru.setVar("insuranceAndContractsPocketId", insuranceAndContractsPocket.id);
    bru.setVar("rentAndAppliancesPocketId", rentAndAppliancesPocket.id);
}
