    "title": "1Password",
    "description": "1Password",
    "amount": 3784,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2025-11-20",
    "finalOccurrenceDate": null,
    "recurrenceType": "YEARLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [20],
    "monthsOfYear": [11],
    "maxRecurrenceCount": null
  }
}
vars:pre-request {
