    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [1],
    "monthsOfYear": null,
    "maxRecurrenceCount": null
  }
}
vars:pre-request {
  contractAccountName: Insurance & Contracts
  contractName: Netflix
  partnerName: Netflix
