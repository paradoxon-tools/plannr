meta {
  name: Reserve Haftpflichtversicherung - Rückstellung
  type: http
}

post {
  url: {{baseUrl}}/transactions/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sourcePocketId": "{{seedReserveSourcePocketId}}",
    "destinationPocketId": "{{seedContractPocketId}}",
    "partnerId": null,
    "title": "Reserve Haftpflichtversicherung",
    "description": "Rückstellung (9)",
    "amount": 612,
    "currencyCode": "EUR",
    "transactionType": "TRANSFER",
    "firstOccurrenceDate": "2025-08-01",
    "finalOccurrenceDate": null,
    "recurrenceType": "MONTHLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [1],
    "monthsOfYear": null,
    "maxRecurrenceCount": null
  }
}

vars:pre-request {
  contractAccountName: Insurance & Contracts
  contractName: Haftpflichtversicherung
  partnerName: VHV
  transactionType: TRANSFER
  reserveSourceAccountName: Income Bucket
  reserveSourcePocketName: Default
}