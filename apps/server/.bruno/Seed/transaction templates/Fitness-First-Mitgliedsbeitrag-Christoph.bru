meta {
  name: Fitness First - Mitgliedsbeitrag (Christoph)
  type: http
}

post {
  url: {{baseUrl}}/transactions/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sourcePocketId": "{{seedContractPocketId}}",
    "destinationPocketId": null,
    "partnerId": "{{seedPartnerId}}",
    "title": "Fitness First",
    "description": "Mitgliedsbeitrag (Christoph) (26)",
    "amount": 2180,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2025-03-04",
    "finalOccurrenceDate": null,
    "recurrenceType": "WEEKLY",
    "skipCount": 1,
    "daysOfWeek": ["TUESDAY"],
    "weeksOfMonth": null,
    "daysOfMonth": null,
    "monthsOfYear": null,
    "maxRecurrenceCount": null
  }
}

vars:pre-request {
  contractAccountName: Insurance & Contracts
  contractName: Fitness First
  partnerName: Fitness First
  transactionType: EXPENSE
  reserveSourceAccountName: Income Bucket
  reserveSourcePocketName: Default
}