meta {
  name: Rechtsschutzversicherung
  type: http
}

post {
  url: {{baseUrl}}/transactions/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sourcePocketId": "{{seedContractPocketId}}",
    "destinationPocketId": null,
    "partnerId": "{{seedPartnerId}}",
    "title": "Rechtsschutzversicherung",
    "description": "Rechtsschutzversicherung",
    "amount": 26700,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2025-04-01",
    "finalOccurrenceDate": null,
    "recurrenceType": "YEARLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [1],
    "monthsOfYear": [4],
    "maxRecurrenceCount": null
  }
}

vars:pre-request {
  contractAccountName: Insurance & Contracts
  contractName: Rechtsschutzversicherung
  partnerName: KS/Auxilia
  transactionType: EXPENSE
  reserveSourceAccountName: Income Bucket
  reserveSourcePocketName: Default
}