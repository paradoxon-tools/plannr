meta {
  name: Catalina Growth Fund - Trade Republic
  type: http
}

post {
  url: {{baseUrl}}/pockets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "accountId": "{{account_trade_republic}}",
    "name": "Catalina Growth Fund",
    "description": "Langfristige Rücklage aus dem Kindergeld und Geschenken für Catalina",
    "color": 16753920,
    "isDefault": false
  }
}
