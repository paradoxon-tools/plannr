meta {
  name: Dericon GmbH
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/contracts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "accountId": "{{seedAccountId}}",
    "name": "Dericon GmbH",
    "pocket": {
      "description": null,
      "color": 2733171,
      "useDefaultPocket": false
    },
    "financialProfileId": null,
    "partnerId": "{{seedPartnerId}}",
    "signingDate": null,
    "expirationDate": null,
    "lastCancellationDate": null
  }
}

vars:pre-request {
  accountName: Income Bucket
  partnerName: Dericon GmbH
}
