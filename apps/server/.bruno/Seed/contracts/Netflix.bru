}

body:json {
  {
    "accountId": "{{seedAccountId}}",
    "name": "Netflix",
    "pocket": {
      "description": null,
      "color": 13970206,
      "useDefaultPocket": false
    },
    "financialProfileId": null,
    "partnerId": "{{seedPartnerId}}",
    "signingDate": null,
    "expirationDate": null,
    "lastCancellationDate": null
  }
}

vars:pre-request {
  accountName: Insurance & Contracts
  partnerName: Netflix
}
