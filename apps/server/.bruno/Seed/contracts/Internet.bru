meta {
  name: Internet
  type: http
}

post {
  url: {{baseUrl}}/pockets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "accountId": "{{seedAccountId}}",
    "name": "Internet",
    "description": null,
    "color": 12058624,
    "isDefault": false,
    "contract": {
      "partnerId": "{{seedPartnerId}}",
      "signingDate": null,
      "expirationDate": null,
      "lastCancellationDate": null
    }
  }
}

vars:pre-request {
  accountName: Rent & Appliances
  partnerName: Vodafone
}