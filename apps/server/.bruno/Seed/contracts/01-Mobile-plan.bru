meta {
  name: Mobile plan
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/pockets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

vars:pre-request {
  accountName: XY
  partnerName: XY
}

body:json {
  {
    "accountId": "{{seedAccountId}}",
    "name": "Mobile plan",
    "description": "Sample contract",
    "color": 9125110,
    "isDefault": false,
    "contract": {
      "partnerId": "{{seedPartnerId}}",
      "signingDate": "2026-01-01",
      "expirationDate": null,
      "lastCancellationDate": null
    }
  }
}
