meta {
  name: Smart Launcher
  type: http
}

post {
  url: {{baseUrl}}/pockets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "accountId": "{{seedAccountId}}",
    "name": "Smart Launcher",
    "description": null,
    "color": 3457023,
    "isDefault": false,
    "contract": {
      "partnerId": "{{seedPartnerId}}",
      "signingDate": null,
      "expirationDate": null,
      "lastCancellationDate": null
    }
  }
}

vars:pre-request {
  accountName: Insurance & Contracts
  partnerName: Smart Launcher
}