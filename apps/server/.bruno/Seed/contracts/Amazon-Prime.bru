meta {
  name: Amazon Prime
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/contracts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "name": "Amazon Prime",
    "description": null,
    "color": 30661,
    "type": "ACCUMULATING",
    "accountIds": ["{{seedAccountId}}"],
    "financialProfileId": null,
    "partnerId": "{{seedPartnerId}}",
    "signingDate": null,
    "expirationDate": null,
    "lastCancellationDate": null
  }
}

vars:pre-request {
  accountName: Insurance & Contracts
  partnerName: Amazon Prime
}
