meta {
  name: Amazon Prime
  type: http
}

post {
  url: {{baseUrl}}/pockets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "accountId": "{{seedAccountId}}",
    "name": "Amazon Prime",
    "description": null,
    "color": 30661,
    "isDefault": false,
    "contract": {
      "partnerId": "{{seedPartnerId}}",
      "signingDate": null,
      "expirationDate": null,
      "lastCancellationDate": null
    }
  }
}

vars:pre-request {
  accountName: Insurance & Contracts
  partnerName: Amazon Prime
}