meta {
  name: Update contract
  type: http
}

put {
  url: {{baseUrl}}/contracts/:contractId
  body: json
  auth: none
}

params:path {
  contractId: contract-id
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "partnerId": "partner-id",
    "signingDate": "2026-01-01",
    "expirationDate": null,
    "lastCancellationDate": null
  }
}
