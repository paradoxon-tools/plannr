meta {
  name: Update contract
  type: http
}

put {
  url: {{baseUrl}}/contracts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "contract-id",
    "financialProfileId": "financial-profile-id",
    "partnerId": "partner-id",
    "name": "Mobile plan",
    "description": "Sample contract",
    "color": 9125110,
    "type": "ACCUMULATING",
    "signingDate": "2026-01-01",
    "expirationDate": null,
    "lastCancellationDate": null
  }
}
