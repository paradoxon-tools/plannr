meta {
  name: Update contract
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/pockets/:pocketId/contract
  body: json
  auth: none
}

params:path {
  pocketId: pocket-id
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "contract-id",
    "partnerId": "partner-id",
    "startDate": "2026-01-01",
    "endDate": null,
    "description": "Updated sample contract"
  }
}
