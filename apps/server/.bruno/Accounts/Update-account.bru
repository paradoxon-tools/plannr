meta {
  name: Update account
  type: http
}

docs {
  Currency changes return 409 data_conflict while this account is linked to a bank account.
  Undo reconciliations and unlink the bank account before changing its currency.
}

put {
  url: {{baseUrl}}/accounts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "account-id",
    "name": "Main account",
    "institution": "N26",
    "currencyCode": "EUR",
    "weekendHandling": "NO_SHIFT"
  }
}
