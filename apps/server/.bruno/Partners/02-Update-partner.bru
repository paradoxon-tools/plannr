meta {
  name: Update partner
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/partners
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": "{{partnerId}}",
    "name": "Acme Inc",
    "notes": "Updated sample partner"
  }
}
