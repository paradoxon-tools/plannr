meta {
  name: Remove partner logo
  type: http
}

delete {
  url: {{baseUrl}}/partners/{{partnerId}}/logo
  body: none
  auth: none
}

headers {
  Accept: application/json
}

docs {
  Website is transient and never persisted. Preview does not save a logo.
  Set partnerId, logoVersion and logoBase64 from the partner/preview responses as appropriate.
  Saved images are normalized PNGs; versioned image URLs are cached immutably.
}
