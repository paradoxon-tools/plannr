meta {
  name: Create recurring transaction
  type: http
}

post {
  url: {{baseUrl}}/transactions/recurring
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sourcePocketId": "pocket-id",
    "destinationPocketId": null,
    "partnerId": "partner-id",
    "title": "Monthly subscription",
    "description": "Sample recurring expense",
    "amount": 999,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2026-04-15",
    "finalOccurrenceDate": null,
    "recurrenceType": "MONTHLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [15],
    "monthsOfYear": null,
    "maxRecurrenceCount": null
  }
}
