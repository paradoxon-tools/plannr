meta {
  name: Create standalone pocket
  type: http
}

post {
  url: {{baseUrl}}/pockets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "accountId": "account-id",
    "name": "General",
    "description": "Primary pocket",
    "color": 16711680,
    "isDefault": true
  }
}
