meta {
  name: Update transaction template
  type: http
}

put {
  url: {{baseUrl}}/transactions/templates
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "id": 1,
    "sourcePocketId": 1,
    "destinationPocketId": null,
    "financialProfileId": 1,
    "partnerId": 1,
    "title": "Monthly subscription",
    "description": "Updated recurring expense",
    "amount": 1099,
    "currencyCode": "EUR",
    "transactionType": "EXPENSE",
    "firstOccurrenceDate": "2026-04-15",
    "finalOccurrenceDate": null,
    "recurrenceType": "MONTHLY",
    "skipCount": 0,
    "daysOfWeek": null,
    "weeksOfMonth": null,
    "daysOfMonth": [15],
    "monthsOfYear": null,
    "maxRecurrenceCount": null
  }
}
